GEMINI_API_KEY=your_gemini_key
GOOGLE_APPLICATION_CREDENTIALS=path_to_your_google_credentials.json
DEEPGRAM_API_KEY=your_deepgram_key

# Backend deployment split:
# - api: only Gemini API pipeline
# - local: only TurboQuant local pipeline
# - hybrid: both are available
DEPLOYMENT_MODE=hybrid

# Local AI mode for the thesis: TurboQuant local runtime
LOCAL_LLM_BACKEND=turboquant
LOCAL_LLM_AUTOSTART=1
LOCAL_LLM_HOST=127.0.0.1
LOCAL_LLM_PORT=8011
LOCAL_LLM_TIMEOUT_S=120
LOCAL_LLM_MAX_TOKENS=256
LOCAL_LLM_MODEL_NAME=your-model.gguf
LOCAL_LLM_GGUF_PATH=path\to\your-model.gguf

# TurboQuant mode
# Build llama-server with the provided setup script, then point this variable to it.
TURBOQUANT_SERVER_BIN=path\to\llama-server.exe
TURBOQUANT_CACHE_TYPE=turbo2
TURBOQUANT_NGL=99
TURBOQUANT_CTX=4096
TURBOQUANT_REASONING_BUDGET=0

# ----- Speculative decoding (optional) -----
# Draft model accelerates generation ~1.5-2x with a smaller sibling model.
# Leave LOCAL_LLM_DRAFT_GGUF_PATH empty to DISABLE speculative decoding
# (recommended for GPUs with <=5GB VRAM). Example pair: 8B main + 1B draft.
LOCAL_LLM_DRAFT_GGUF_PATH=
LOCAL_LLM_DRAFT_NGL=99
LOCAL_LLM_DRAFT_CTX=2048
LOCAL_LLM_DRAFT_MAX=16
LOCAL_LLM_DRAFT_MIN=0
LOCAL_LLM_DRAFT_P_MIN=0.75

# ----- Conversation summarization -----
# Set MEMORY_SUMMARY_ENABLED=0 to turn off the rolling summary feature.
MEMORY_SUMMARY_ENABLED=1
MEMORY_SUMMARY_KEEP_RECENT=4
MEMORY_SUMMARY_BATCH=6
MEMORY_SUMMARY_MAX_CHARS=600

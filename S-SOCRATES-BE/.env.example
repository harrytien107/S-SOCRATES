GEMINI_API_KEY=your_gemini_key
GOOGLE_APPLICATION_CREDENTIALS=path_to_your_google_credentials.json
DEEPGRAM_API_KEY=your_deepgram_key

# Backend runtime command. Use "python" if Python is available in PATH,
# or set the absolute path to your virtualenv Python executable.
BACKEND_PYTHON_EXE=python

# Backend deployment split:
# - api: only Gemini API pipeline
# - local: only TurboQuant local pipeline
# - hybrid: both are available
DEPLOYMENT_MODE=hybrid

# Local AI shared settings (USED BY BOTH TurboQuant and Baseline)
LOCAL_HOST=127.0.0.1
LOCAL_TIMEOUT_S=300
LOCAL_MAX_TOKENS=256
LOCAL_MODEL_NAME=your_model.gguf
LOCAL_GGUF_PATH=path\to\your-model.gguf
LOCAL_SERVER_BIN=path\to\llama-server.exe
LOCAL_NGL=99
LOCAL_CTX=4096
LOCAL_REASONING_BUDGET=0

# Optional mode switches (you can keep defaults if not needed)
LOCAL_TYPE=turbo2
LOCAL_LLM_PORT=8011
LOCAL_LLM_AUTOSTART=1
LOCAL_BASELINE_PORT=8012
LOCAL_BASELINE_AUTOSTART=1

# Optional setup locations. Change these on each machine instead of editing scripts.
SETUP_SOFTWARE_ROOT=path\to
TURBOQUANT_WORKSPACE_ROOT=path\to\BuildTool
BACKEND_VENV_ROOT=path\to\BuildTool\venvs\
